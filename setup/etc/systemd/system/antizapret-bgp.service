[Unit]
Description=AntiZapret private BGP route announcer
After=network-online.target antizapret.service openvpn-server@antizapret-udp.service openvpn-server@antizapret-tcp.service wg-quick@antizapret.service
Wants=network-online.target

[Service]
Type=simple
User=bird
Group=bird
AmbientCapabilities=CAP_NET_BIND_SERVICE
RuntimeDirectory=antizapret-bgp
RuntimeDirectoryMode=0755
StateDirectory=antizapret-bgp
StateDirectoryMode=0755
UMask=0022
ExecStartPre=+/root/antizapret/bgp-update.py --prepare-only
ExecStartPre=+/root/antizapret/bgp-firewall.sh up
ExecStart=/usr/sbin/bird -f -c /etc/antizapret-bgp/bird.conf -s /run/antizapret-bgp/bird.ctl -P /run/antizapret-bgp/bird.pid
ExecReload=/usr/sbin/birdc -s /run/antizapret-bgp/bird.ctl configure
ExecStopPost=+/root/antizapret/bgp-firewall.sh down
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
